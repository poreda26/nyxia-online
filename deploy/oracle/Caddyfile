# Sahip paneli: https://panel.nyxiaonline.com
panel.nyxiaonline.com {
	encode zstd gzip
	@root path /
	redir @root /owner.html
	reverse_proxy 127.0.0.1:3000
}

# www -> kök adres
www.nyxiaonline.com {
	redir https://nyxiaonline.com{uri} permanent
}

# Ana adres: tanıtım sitesi + wiki + destek (statik, /var/www/nyxia-site) ve oyun API'si
nyxiaonline.com {
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	# Beta: oyunun tarayıcı sürümü (/beta/, `vite build --base /beta/` çıktısı)
	redir /beta /beta/ permanent
	handle_path /beta/* {
		root * /var/www/nyxia-beta
		file_server
	}
	handle {
		root * /var/www/nyxia-site
		file_server
	}
}
